---
// Guscio dell'app (step 3): intestazione con l'accesso alle Impostazioni, contenuto che scorre e,
// nella zona del pollice, lo stack fisso in basso: mini-barra dell'allenamento in corso (step 6),
// barra di salvataggio (solo quando c'è un problema) e tab bar; sopra a tutto, quando serve, il timer di
// recupero a tutto schermo (step 7). La navigazione tra le pagine passa dal
// ClientRouter, che tiene caricati i moduli (archivio compreso) e scambia solo il contenuto.
// L'altezza dello stack è in --bottom-bars-height (src/lib/bottom-bars.ts).
import { ClientRouter } from 'astro:transitions';
import Base from './Base.astro';
import AppHeader from '../components/ui/AppHeader.astro';
import TabBar, { type TabId } from '../components/ui/TabBar.astro';
import ArchiveStatus from '../components/shell/ArchiveStatus.svelte';
import WorkoutMiniBar from '../components/shell/WorkoutMiniBar.svelte';
import RestTimerHost from '../components/shell/RestTimerHost.svelte';

interface Props {
  title: string;
  /** false: il titolo del documento è solo «Workout Tracker» (home) */
  suffixTitle?: boolean;
  /** titolo nell'intestazione, se diverso da quello del documento */
  heading?: string;
  subtitle?: string;
  description?: string;
  /** voce attiva della tab bar; nessuna nelle Impostazioni */
  tab?: TabId;
  /** false nelle schermate senza navigazione (primo avvio) e nell'allenamento in corso, che è una modalità */
  showTabs?: boolean;
  showHeader?: boolean;
  showSettings?: boolean;
  /** false nella pagina Info */
  showInfo?: boolean;
  /** false dove la pagina mostra da sé lo stato del salvataggio (allenamento attivo) */
  showArchiveStatus?: boolean;
  /** ritorno nell'intestazione, per le pagine senza tab bar */
  back?: { href: string; label: string };
}

const {
  title,
  suffixTitle = true,
  heading = title,
  subtitle,
  description,
  tab,
  showTabs = true,
  showHeader = true,
  showSettings = true,
  showInfo = true,
  showArchiveStatus = true,
  back,
} = Astro.props;

// Altezza della tab bar (56px più il filo superiore), senza l'area sicura che la tab bar aggiunge da sé
const TAB_BAR_HEIGHT = 57;
const barsBelow = showTabs ? TAB_BAR_HEIGHT : 0;
---

<Base title={suffixTitle ? `${title} · Workout Tracker` : 'Workout Tracker'} description={description} bodyStyle={`--bottom-bars-base: ${barsBelow}px; --bottom-bars-height: ${barsBelow}px`}>
  <ClientRouter slot="head" />
  {showHeader && <AppHeader title={heading} subtitle={subtitle} showSettings={showSettings} showInfo={showInfo} back={back} />}

  <main class="mx-auto w-full max-w-2xl px-4 pt-6 pb-[calc(var(--bottom-bars-height)+env(safe-area-inset-bottom)+2rem)]">
    <slot />
  </main>

  <div class="fixed inset-x-0 bottom-0 z-20" transition:animate="none">
    <!-- persistente tra le pagine: niente lampo della barra a ogni cambio di pagina -->
    <WorkoutMiniBar client:only="svelte" transition:persist="workout-mini-bar" />
    {showArchiveStatus && <ArchiveStatus client:only="svelte" />}
    {showTabs && <TabBar active={tab} />}
  </div>

  <!-- il recupero continua tra le pagine: la finestra del timer resta la stessa -->
  <RestTimerHost client:only="svelte" transition:persist="rest-timer" />
</Base>

<script>
  // Moduli: girano una volta per visita, anche con il ClientRouter
  import { listenForInstallPrompt, registerServiceWorker } from '../lib/pwa';

  listenForInstallPrompt();
  registerServiceWorker();
</script>
