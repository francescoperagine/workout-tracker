---
/* Nessuna logica server-side: tutto client */
---

<div data-workout-editor class="max-w-3xl mx-auto mt-8 bg-white p-8 rounded-2xl shadow-xl">
  <div class="border-b pb-4 mb-6">
    <h2 class="text-3xl font-bold text-gray-900 mb-2">🏋️‍♂️ Allenamento del giorno</h2>
    <p class="text-gray-500 text-sm">Traccia i tuoi progressi in palestra</p>
  </div>

  <label class="block mb-6">
    <span class="text-sm font-medium text-gray-700 mb-2 block">Data allenamento</span>
    <input id="workout-date" type="date" class="mt-1 w-full rounded-lg border-2 border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition px-4 py-2" />
  </label>

  <div id="exercise-list" class="space-y-4 mb-6"></div>

  <div class="mt-6 flex justify-between items-center pt-6 border-t">
    <button
      id="add-exercise"
      class="bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition shadow-md hover:shadow-lg font-medium"
    >
      + Aggiungi esercizio
    </button>

    <button
      id="export-json"
      class="text-gray-600 hover:text-gray-900 py-3 px-6 rounded-lg hover:bg-gray-100 transition font-medium"
    >
      💾 Esporta JSON
    </button>
  </div>

  <script>
    import { getWorkout, putWorkout, parseDateKey, toDateKey, downloadJson, UPDATED_EVENT, type Workout } from '../scripts/bodytracker'
    import { mountExerciseList, promptNewExercise } from '../scripts/exercise-list'

    const root = document.querySelector<HTMLElement>('[data-workout-editor]')
    if (!root) throw new Error('Workout editor root not found')

    const dateInput = root.querySelector<HTMLInputElement>('#workout-date')!
    const list = root.querySelector<HTMLElement>('#exercise-list')!
    const addExerciseBtn = root.querySelector<HTMLButtonElement>('#add-exercise')!
    const exportBtn = root.querySelector<HTMLButtonElement>('#export-json')!

    let workout: Workout = getWorkout(toDateKey(new Date()))
    dateInput.value = workout.date

    // Evita di ricaricare l'editor per l'evento emesso dal proprio salvataggio
    let saving = false
    function save() {
      saving = true
      try {
        putWorkout(workout)
      } finally {
        saving = false
      }
    }

    function addExercise() {
      if (!promptNewExercise(workout)) return
      save()
      render()
    }

    const render = mountExerciseList(list, {
      getWorkout: () => workout,
      onChange: save,
      emptyText: 'Inizia ad aggiungere esercizi per tracciare il tuo allenamento',
      onAddFirst: addExercise,
    })

    function reload() {
      if (saving) return
      workout = getWorkout(workout.date)
      render()
    }

    addExerciseBtn.addEventListener('click', addExercise)

    exportBtn.addEventListener('click', () => {
      // Array di un elemento: lo stesso formato accettato da "Importa" nello storico
      downloadJson([workout], `workout-${workout.date}.json`)
    })

    dateInput.addEventListener('change', () => {
      if (!parseDateKey(dateInput.value)) return
      workout = getWorkout(dateInput.value)
      render()
    })

    window.addEventListener(UPDATED_EVENT, reload)
    window.addEventListener('storage', reload)

    render()
  </script>
</div>
