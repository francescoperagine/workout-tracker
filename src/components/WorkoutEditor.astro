---
/* Nessuna logica server-side: tutto client */
---

<div data-workout-editor class="max-w-3xl mx-auto mt-8 bg-white p-8 rounded-2xl shadow-xl">
  <div class="border-b pb-4 mb-6">
    <h2 class="text-3xl font-bold text-gray-900 mb-2">🏋️‍♂️ Allenamento del giorno</h2>
    <p class="text-gray-500 text-sm">Traccia i tuoi progressi in palestra</p>
  </div>

  <label class="block mb-6">
    <span class="text-sm font-medium text-gray-700 mb-2 block">Data allenamento</span>
    <input id="workout-date" type="date" class="mt-1 w-full rounded-lg border-2 border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition px-4 py-2" />
  </label>

  <div id="exercise-list" class="space-y-4 mb-6"></div>

  <div class="mt-6 flex justify-between items-center pt-6 border-t">
    <button
      id="add-exercise"
      class="bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition shadow-md hover:shadow-lg font-medium"
    >
      + Aggiungi esercizio
    </button>

    <button
      id="export-json"
      class="text-gray-600 hover:text-gray-900 py-3 px-6 rounded-lg hover:bg-gray-100 transition font-medium"
    >
      💾 Esporta JSON
    </button>
  </div>

  <script type="module">
    // Otteniamo l’elemento principale in modo sicuro
    const root = document.querySelector('[data-workout-editor]')
    if (!root) {
      console.error('Workout editor root not found')
    }

    const dateInput = root.querySelector('#workout-date')
    const list = root.querySelector('#exercise-list')
    const addExerciseBtn = root.querySelector('#add-exercise')
    const exportBtn = root.querySelector('#export-json')

    let workout = JSON.parse(localStorage.getItem('workout') || 'null') || {
      date: new Date().toISOString().split('T')[0],
      exercises: [],
    }

    dateInput.value = workout.date

    function save() {
      localStorage.setItem('workout', JSON.stringify(workout))
    }

    function render() {
      list.innerHTML = ''

      if (workout.exercises.length === 0) {
        list.innerHTML = `
          <div class="text-center py-12 px-6 bg-gray-50 rounded-xl border-2 border-dashed border-gray-300">
            <div class="text-6xl mb-4">💪</div>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">Nessun esercizio ancora</h3>
            <p class="text-gray-500 mb-4">Inizia ad aggiungere esercizi per tracciare il tuo allenamento</p>
            <button id="empty-state-add" class="bg-blue-600 text-white py-2 px-6 rounded-lg hover:bg-blue-700 transition font-medium">
              + Aggiungi il primo esercizio
            </button>
          </div>
        `
        const emptyBtn = list.querySelector('#empty-state-add')
        emptyBtn?.addEventListener('click', addExercise)
        return
      }

      workout.exercises.forEach((ex, i) => {
        const exDiv = document.createElement('div')
        exDiv.className = 'p-5 border-2 border-gray-200 rounded-xl bg-linear-to-br from-gray-50 to-white shadow-sm hover:shadow-md transition'

        const setsHTML = ex.sets
          .map(
            (set, j) => `
            <div class="grid grid-cols-4 gap-2 mb-2">
              <div class="flex items-center justify-center font-medium text-gray-700">${j + 1}</div>
              <input type="number" class="rounded-lg border-gray-300 text-center focus:ring-2 focus:ring-blue-500 focus:border-blue-500" value="${set.reps}" min="1" data-reps="${i}-${j}" />
              <input type="number" class="rounded-lg border-gray-300 text-center focus:ring-2 focus:ring-blue-500 focus:border-blue-500" value="${set.weight}" min="0" step="0.5" data-weight="${i}-${j}" />
              <button class="text-red-500 hover:text-red-700 transition text-sm" data-deleteset="${i}-${j}" ${ex.sets.length === 1 ? 'disabled class="text-gray-300 cursor-not-allowed"' : ''}>
                ✕
              </button>
            </div>`
          )
          .join('')

        exDiv.innerHTML = `
          <div class="flex justify-between items-center mb-3">
            <h3 class="font-semibold text-lg text-gray-800">${ex.name}</h3>
            <div class="flex gap-2">
              <button class="text-sm text-blue-600 hover:text-blue-800 transition" data-addset="${i}">
                + Aggiungi serie
              </button>
              <button class="text-sm text-red-600 hover:text-red-800 transition" data-deleteex="${i}">
                🗑️ Elimina
              </button>
            </div>
          </div>
          <div class="grid grid-cols-4 gap-2 text-sm font-medium text-gray-600 mb-2">
            <div>Serie</div><div>Ripetizioni</div><div>Peso (kg)</div><div></div>
          </div>
          ${setsHTML}
        `
        list.appendChild(exDiv)
      })
    }

    function addExercise() {
      const name = prompt('Nome esercizio?')
      if (!name) return
      workout.exercises.push({ name, sets: [{ reps: 10, weight: 0 }] })
      save()
      render()
    }

    list.addEventListener('input', (e) => {
      const target = e.target
      if (!(target instanceof HTMLInputElement)) return
      const repsAttr = target.getAttribute('data-reps')
      const weightAttr = target.getAttribute('data-weight')
      if (repsAttr) {
        const [i, j] = repsAttr.split('-').map(Number)
        workout.exercises[i].sets[j].reps = Number(target.value)
      } else if (weightAttr) {
        const [i, j] = weightAttr.split('-').map(Number)
        workout.exercises[i].sets[j].weight = Number(target.value)
      }
      save()
    })

    list.addEventListener('click', (e) => {
      const target = e.target
      if (!(target instanceof HTMLElement)) return

      const addset = target.getAttribute('data-addset')
      if (addset) {
        const i = Number(addset)
        workout.exercises[i].sets.push({ reps: 10, weight: 0 })
        save()
        render()
        return
      }

      const deleteset = target.getAttribute('data-deleteset')
      if (deleteset) {
        const [i, j] = deleteset.split('-').map(Number)
        if (workout.exercises[i].sets.length > 1) {
          if (confirm('Rimuovere questa serie?')) {
            workout.exercises[i].sets.splice(j, 1)
            save()
            render()
          }
        }
        return
      }

      const deleteex = target.getAttribute('data-deleteex')
      if (deleteex) {
        const i = Number(deleteex)
        if (confirm(`Eliminare l'esercizio "${workout.exercises[i].name}"?`)) {
          workout.exercises.splice(i, 1)
          save()
          render()
        }
        return
      }
    })

    addExerciseBtn.addEventListener('click', addExercise)

    exportBtn.addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(workout, null, 2)], { type: 'application/json' })
      const a = document.createElement('a')
      a.href = URL.createObjectURL(blob)
      a.download = `workout-${workout.date}.json`
      a.click()
    })

    dateInput.addEventListener('input', (e) => {
      const target = e.target
      if (target instanceof HTMLInputElement) {
        workout.date = target.value
        save()
      }
    })

    render()
  </script>
</div>
