---
import { WEEK_DAYS } from '../scripts/bodytracker'
---
<div data-calendar-config class="p-4 border rounded">
    <h2 class="font-medium mb-2">Calendario allenamenti (settimana)</h2>
    <p class="text-sm text-slate-500 mb-3">Assegna per ogni giorno la scheda (nome) da eseguire.</p>


    <form class="space-y-2" onsubmit="return false;">
        <!-- giorni della settimana -->
        {WEEK_DAYS.map(day => (
            <div class="flex items-center gap-2">
                <label class="w-20 text-sm" for={`cal-${day}`}>{day}</label>
                <input class="flex-1 input" id={`cal-${day}`} data-day={day} placeholder="es. Petto" />
            </div>
        ))}


        <div class="flex gap-2 mt-3">
            <button id="save-cal" class="px-3 py-1 rounded bg-slate-800 text-white text-sm">Salva</button>
            <button id="reset-cal" type="button" class="px-3 py-1 rounded border text-sm">Reset</button>
        </div>
    </form>

    <script>
        import { loadCalendar, saveCalendar, resetCalendar, UPDATED_EVENT, type CalendarConfig } from '../scripts/bodytracker'

        const root = document.querySelector<HTMLElement>('[data-calendar-config]')!
        const inputs = root.querySelectorAll<HTMLInputElement>('input[data-day]')


        function load() {
            const data = loadCalendar()
            inputs.forEach(i => {
                i.value = data[i.dataset.day!] || ''
            })
        }


        function save() {
            const obj: CalendarConfig = {}
            inputs.forEach(i => {
                const value = i.value.trim()
                if (value) obj[i.dataset.day!] = value
            })
            saveCalendar(obj)
            window.dispatchEvent(new CustomEvent(UPDATED_EVENT))
            alert('Calendario salvato nel browser')
        }


        root.querySelector('#save-cal')!.addEventListener('click', save)
        root.querySelector('#reset-cal')!.addEventListener('click', () => {
            if (!confirm('Resettare il calendario?')) return
            resetCalendar()
            window.dispatchEvent(new CustomEvent(UPDATED_EVENT))
            load()
        })

        load()
    </script>
</div>
