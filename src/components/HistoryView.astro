---
/* Nessuna logica server-side: tutto client */
---
<div data-history-view class="p-4 border rounded mt-4">
<h2 class="font-medium mb-2">Storico allenamenti</h2>


<div class="flex flex-wrap gap-2 mb-3">
<button id="refresh" class="px-3 py-1 rounded border">Aggiorna</button>
<button id="export" class="px-3 py-1 rounded bg-blue-600 text-white">Esporta JSON</button>
<label class="px-3 py-1 rounded border cursor-pointer">
Importa
<input id="import-file" type="file" accept="application/json" class="hidden" />
</label>
<button id="clear" class="px-3 py-1 rounded border text-red-600">Cancella tutto</button>
</div>


<div id="list" class="space-y-2 text-sm"></div>
<script>
import { loadWorkouts, mergeWorkouts, clearWorkouts, parseWorkouts, parseDateKey, toDateKey, escapeHtml, workoutUrl, downloadJson, UPDATED_EVENT } from '../scripts/bodytracker'

const root = document.querySelector<HTMLElement>('[data-history-view]')!
const importInput = root.querySelector<HTMLInputElement>('#import-file')!


function render() {
const list = loadWorkouts().reverse()
const el = root.querySelector<HTMLElement>('#list')!
el.innerHTML = ''
if (!list.length) {
el.innerHTML = '<div class="text-slate-500">Nessun allenamento registrato.</div>'
return
}


list.forEach(item => {
const d = parseDateKey(item.date)!.toLocaleDateString('it-IT', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })
const card = document.createElement('a')
card.href = workoutUrl(item.date)
card.className = 'block p-2 border rounded hover:bg-gray-50 transition'
const exercises = item.exercises.map(e => `<div><strong>${escapeHtml(e.name)}</strong> - ${e.sets.length} serie</div>`).join('')
card.innerHTML = `<div class="flex justify-between"><div class="font-medium">${escapeHtml(d)}</div><div class="text-xs">${item.exercises.length} esercizi</div></div><div class="text-xs mt-1">${exercises}</div>`
el.appendChild(card)
})
}


root.querySelector('#refresh')!.addEventListener('click', render)


root.querySelector('#export')!.addEventListener('click', () => {
downloadJson(loadWorkouts(), `bb-workouts-${toDateKey(new Date())}.json`)
})


importInput.addEventListener('change', async () => {
const f = importInput.files?.[0]
if (!f) return
try {
const parsed = parseWorkouts(JSON.parse(await f.text()))
if (!confirm(`Importare ${parsed.length} allenamenti? Quelli con la stessa data verranno sostituiti.`)) return
mergeWorkouts(parsed)
alert('Importazione completata')
} catch (e) {
alert('Errore importando: ' + (e instanceof Error ? e.message : String(e)))
} finally {
// Permette di reimportare lo stesso file
importInput.value = ''
}
})


root.querySelector('#clear')!.addEventListener('click', () => {
if (!confirm('Sei sicuro di cancellare tutto lo storico?')) return
clearWorkouts()
})


// render on update
window.addEventListener(UPDATED_EVENT, render)
window.addEventListener('storage', render)
render()
</script>
</div>
