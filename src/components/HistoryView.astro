---
const STORAGE_KEY = 'bb-workouts'
---
<div data-history-view class="p-4 border rounded mt-4">
<h2 class="font-medium mb-2">Storico allenamenti</h2>


<div class="flex gap-2 mb-3">
<button id="refresh" class="px-3 py-1 rounded border">Aggiorna</button>
<button id="export" class="px-3 py-1 rounded bg-blue-600 text-white">Esporta JSON</button>
<label class="px-3 py-1 rounded border cursor-pointer">
Importa
<input id="import-file" type="file" accept="application/json" class="hidden" />
</label>
<button id="clear" class="px-3 py-1 rounded border text-red-600">Cancella tutto</button>
</div>


<div id="list" class="space-y-2 text-sm"></div>
<script type="module">
const STORAGE_KEY = 'bb-workouts'
const root = document.querySelector('[data-history-view]')


function loadList() {
const raw = localStorage.getItem(STORAGE_KEY)
return raw ? JSON.parse(raw) : []
}


function render() {
const list = loadList()
const el = root.querySelector('#list')
el.innerHTML = ''
if (!list.length) {
el.innerHTML = '<div class="text-slate-500">Nessun allenamento registrato.</div>'
return
}


list.forEach(item => {
const d = new Date(item.date).toLocaleString()
const card = document.createElement('div')
card.className = 'p-2 border rounded'
card.innerHTML = `<div class="flex justify-between"><div class="font-medium">${item.name}</div><div class="text-xs">${d}</div></div><div class="text-xs mt-1">${item.exercises.map(e=>`<div>${e}</div>`).join('')}</div>`
el.appendChild(card)
})
}


root.querySelector('#refresh').addEventListener('click', render)


root.querySelector('#export').addEventListener('click', () => {
const data = loadList()
const blob = new Blob([JSON.stringify(data, null, 2)], {type:'application/json'})
const url = URL.createObjectURL(blob)
const a = document.createElement('a')
a.href = url
a.download = `bb-workouts-${new Date().toISOString()}.json`
document.body.appendChild(a)
a.click()
a.remove()
URL.revokeObjectURL(url)
})


root.querySelector('#import-file').addEventListener('change', async (ev) => {
const f = ev.target.files[0]
if (!f) return
try {
const txt = await f.text()
const parsed = JSON.parse(txt)
if (!Array.isArray(parsed)) throw new Error('Formato non valido: serve array di allenamenti')
localStorage.setItem(STORAGE_KEY, JSON.stringify(parsed))
alert('Importazione completata')
window.dispatchEvent(new CustomEvent('bb:updated'))
} catch (e) {
alert('Errore importando: ' + e.message)
}
})


root.querySelector('#clear').addEventListener('click', () => {
if (!confirm('Sei sicuro di cancellare tutto lo storico?')) return
localStorage.removeItem(STORAGE_KEY)
window.dispatchEvent(new CustomEvent('bb:updated'))
render()
})


// render on update
window.addEventListener('bb:updated', render)
render()
</script>
</div>