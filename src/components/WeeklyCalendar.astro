---
// Visual weekly calendar with clickable day cards
---

<div data-weekly-calendar class="p-6 bg-white rounded-2xl shadow-lg">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">📅 Calendario Settimanale</h2>
    <p class="text-gray-600 text-sm">Clicca su un giorno per vedere e modificare l'allenamento</p>
  </div>

  <div class="flex items-center justify-between mb-4">
    <button
      id="prev-week"
      class="p-2 rounded-lg hover:bg-gray-100 transition"
      aria-label="Settimana precedente"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <h3 id="week-label" class="text-lg font-semibold text-gray-700"></h3>

    <button
      id="next-week"
      class="p-2 rounded-lg hover:bg-gray-100 transition"
      aria-label="Settimana successiva"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3" id="calendar-days">
    <!-- Days will be rendered here by JavaScript -->
  </div>
</div>

<script>
  import { loadCalendar, loadWorkouts, toDateKey, dayNameOf, escapeHtml, workoutUrl, DAY_NAMES_SHORT, UPDATED_EVENT } from '../scripts/bodytracker';

  const root = document.querySelector<HTMLElement>('[data-weekly-calendar]')!;
  const daysContainer = root.querySelector<HTMLElement>('#calendar-days')!;
  const weekLabel = root.querySelector<HTMLElement>('#week-label')!;
  const prevBtn = root.querySelector<HTMLButtonElement>('#prev-week')!;
  const nextBtn = root.querySelector<HTMLButtonElement>('#next-week')!;

  let currentWeekOffset = 0;

  function getMonday(d: Date) {
    const date = new Date(d.getFullYear(), d.getMonth(), d.getDate());
    const day = date.getDay();
    date.setDate(date.getDate() - day + (day === 0 ? -6 : 1));
    return date;
  }

  function render() {
    const monday = getMonday(new Date());
    monday.setDate(monday.getDate() + (currentWeekOffset * 7));

    const calendarConfig = loadCalendar();
    const datesWithWorkout = new Set(
      loadWorkouts().filter(w => w.exercises.length > 0).map(w => w.date)
    );
    const todayKey = toDateKey(new Date());

    // Update week label
    const endOfWeek = new Date(monday);
    endOfWeek.setDate(endOfWeek.getDate() + 6);
    weekLabel.textContent = `${monday.getDate()} ${monday.toLocaleDateString('it-IT', { month: 'short' })} - ${endOfWeek.getDate()} ${endOfWeek.toLocaleDateString('it-IT', { month: 'short' })} ${endOfWeek.getFullYear()}`;

    daysContainer.innerHTML = '';

    for (let i = 0; i < 7; i++) {
      const date = new Date(monday);
      date.setDate(date.getDate() + i);
      const dateKey = toDateKey(date);

      const isToday = dateKey === todayKey;
      const plannedWorkout = calendarConfig[dayNameOf(date)] || '';
      const hasWorkout = datesWithWorkout.has(dateKey);

      const dayCard = document.createElement('a');
      dayCard.href = workoutUrl(dateKey);
      dayCard.className = `
        block p-4 rounded-xl border-2 transition-all cursor-pointer
        ${isToday ? 'border-blue-500 bg-blue-50 shadow-md' : 'border-gray-200 bg-white hover:border-blue-300 hover:shadow-md'}
        ${hasWorkout ? 'ring-2 ring-green-400' : ''}
      `;

      dayCard.innerHTML = `
        <div class="text-center">
          <div class="text-xs font-medium text-gray-500 uppercase mb-1">${DAY_NAMES_SHORT[date.getDay()]}</div>
          <div class="text-2xl font-bold ${isToday ? 'text-blue-600' : 'text-gray-900'} mb-2">
            ${date.getDate()}
          </div>
          ${plannedWorkout ? `
            <div class="text-xs font-medium text-gray-700 bg-gray-100 rounded px-2 py-1 mb-1">
              ${escapeHtml(plannedWorkout)}
            </div>
          ` : ''}
          ${hasWorkout ? `
            <div class="flex items-center justify-center gap-1 text-xs text-green-600 font-medium">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Completato</span>
            </div>
          ` : `
            <div class="text-xs text-gray-400">Nessun dato</div>
          `}
        </div>
      `;

      daysContainer.appendChild(dayCard);
    }
  }

  prevBtn.addEventListener('click', () => {
    currentWeekOffset--;
    render();
  });

  nextBtn.addEventListener('click', () => {
    currentWeekOffset++;
    render();
  });

  // Re-render when workouts are updated
  window.addEventListener(UPDATED_EVENT, render);
  window.addEventListener('storage', render);

  render();
</script>
