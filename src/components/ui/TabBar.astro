---
// Navigazione principale in basso, nella zona del pollice (P2). Le Impostazioni stanno nell'intestazione.
import House from '@lucide/astro/icons/house';
import CalendarDays from '@lucide/astro/icons/calendar-days';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import History from '@lucide/astro/icons/rotate-ccw-clock';

export type TabId = 'today' | 'calendar' | 'routines' | 'history';

interface Props {
  active?: TabId;
}

const { active } = Astro.props;

const tabs = [
  { id: 'today', label: 'Oggi', href: '/', Icon: House },
  { id: 'calendar', label: 'Calendario', href: '/calendar', Icon: CalendarDays },
  { id: 'routines', label: 'Schede', href: '/routines', Icon: ClipboardList },
  { id: 'history', label: 'Storico', href: '/history', Icon: History },
] as const;
---

<nav class="shell border-t border-shell-line pb-[env(safe-area-inset-bottom)]" aria-label="Sezioni">
  <ul class="mx-auto grid max-w-2xl grid-cols-4">
    {
      tabs.map(({ id, label, href, Icon }) => (
        <li>
          <a
            href={href}
            aria-current={active === id ? 'page' : undefined}
            class:list={[
              'flex min-h-14 flex-col items-center justify-center gap-0.5 text-xs no-underline',
              active === id ? 'font-bold text-shell-accent' : 'text-shell-muted hover:text-shell-foreground',
            ]}
          >
            <Icon size={22} aria-hidden="true" />
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
