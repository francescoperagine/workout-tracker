---
// Navigazione principale in basso, nella zona del pollice (P2). Le Impostazioni stanno nell'intestazione.
import House from '@lucide/astro/icons/house';
import CalendarDays from '@lucide/astro/icons/calendar-days';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import History from '@lucide/astro/icons/rotate-ccw-clock';
import { appUrl } from '../../lib/paths';

export type TabId = 'today' | 'calendar' | 'routines' | 'history';

interface Props {
  active?: TabId;
}

const { active } = Astro.props;

const tabs = [
  { id: 'today', label: 'Oggi', href: appUrl('/'), Icon: House },
  { id: 'calendar', label: 'Calendario', href: appUrl('/calendar'), Icon: CalendarDays },
  { id: 'routines', label: 'Schede', href: appUrl('/routines'), Icon: ClipboardList },
  { id: 'history', label: 'Storico', href: appUrl('/history'), Icon: History },
] as const;
---

<nav transition:animate="none" class="shell border-t border-border pb-[env(safe-area-inset-bottom)]" aria-label="Sezioni">
  <ul class="mx-auto grid max-w-2xl grid-cols-4">
    {
      tabs.map(({ id, label, href, Icon }) => (
        <li>
          <a
            href={href}
            aria-current={active === id ? 'page' : undefined}
            data-tab={id}
            class:list={[
              'tab flex min-h-14 flex-col items-center justify-center gap-0.5 text-xs no-underline',
              active === id ? 'font-bold text-text' : 'text-text-muted hover:text-text',
            ]}
          >
            <Icon size={22} aria-hidden="true" />
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* Tab attiva: testo, grassetto, indicatore di 2px e icona piena. Le icone Lucide sono solo contorno:
     si riempie la sagoma e i dettagli interni si ritagliano nel colore della barra (surface). */
  .tab[aria-current='page'] {
    box-shadow: inset 0 2px 0 var(--color-text);
  }
  [data-tab='today'][aria-current='page'] :global(svg > *),
  [data-tab='calendar'][aria-current='page'] :global(svg > rect),
  [data-tab='routines'][aria-current='page'] :global(svg > :nth-child(-n + 2)),
  [data-tab='history'][aria-current='page'] :global(svg > :first-child) {
    fill: currentColor;
  }
  [data-tab='calendar'][aria-current='page'] :global(svg > :nth-child(n + 4)),
  [data-tab='routines'][aria-current='page'] :global(svg > :nth-child(n + 3)),
  [data-tab='history'][aria-current='page'] :global(svg > :nth-child(3)) {
    stroke: var(--color-surface);
  }
</style>
