---
// Intestazione del guscio: titolo della schermata, riga di stato, accesso a Info e Impostazioni; dove non
// c'è la tab bar (allenamento in corso) anche il ritorno, a sinistra del titolo.
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import CircleQuestionMark from '@lucide/astro/icons/circle-question-mark';
import Settings from '@lucide/astro/icons/settings';
import { appUrl } from '../../lib/paths';

interface Props {
  title: string;
  subtitle?: string;
  /** false nelle schermate che non devono portare alle Impostazioni (es. le Impostazioni stesse) */
  showSettings?: boolean;
  /** false nella pagina Info stessa */
  showInfo?: boolean;
  /** link di ritorno a sinistra del titolo, con la sua etichetta accessibile */
  back?: { href: string; label: string };
}

const { title, subtitle, showSettings = true, showInfo = true, back } = Astro.props;
---

<header transition:animate="none" class="shell sticky top-0 z-20 border-b border-shell-line pt-[env(safe-area-inset-top)]">
  <div class="mx-auto flex min-h-16 max-w-2xl items-center justify-between gap-3 px-4">
    {
      back && (
        <a href={back.href} class="btn btn-icon -ml-3 shrink-0" aria-label={back.label}>
          <ChevronLeft size={22} aria-hidden="true" />
        </a>
      )
    }
    <div class="min-w-0 grow py-2">
      <h1 class="truncate text-lg leading-tight font-bold">{title}</h1>
      {subtitle && <p class="truncate text-sm text-shell-muted">{subtitle}</p>}
    </div>
    <div class="flex items-center gap-1">
      <slot name="actions" />
      {
        showInfo && (
          <a href={appUrl('/info')} class="btn btn-icon" aria-label="Informazioni">
            <CircleQuestionMark size={22} aria-hidden="true" />
          </a>
        )
      }
      {
        showSettings && (
          <a href={appUrl('/settings')} class="btn btn-icon" aria-label="Impostazioni">
            <Settings size={22} aria-hidden="true" />
          </a>
        )
      }
    </div>
  </div>
</header>
