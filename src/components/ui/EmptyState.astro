---
// Stato vuoto: dice cosa comparirà qui e come farlo comparire, con al massimo un'azione.
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<div class="flex flex-col items-start gap-3 py-8">
  <div class="text-muted" aria-hidden="true"><slot name="icon" /></div>
  <h2 class="text-xl leading-snug font-bold">{title}</h2>
  <p class="max-w-[60ch] text-muted">{text}</p>
  <slot />
</div>
