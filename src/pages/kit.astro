---
// Pagina interna del design system: tutti i componenti base nei due temi.
// Fuori dalla navigazione, noindex, escluso dal precache del service worker. ?theme=light|dark forza il tema.
import Base from '../layouts/Base.astro';
import AppHeader from '../components/ui/AppHeader.astro';
import TabBar from '../components/ui/TabBar.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import RestTimer from '../components/workout/RestTimer.svelte';
import KitTheme from '../components/kit/KitTheme.svelte';
import KitSetRows from '../components/kit/KitSetRows.svelte';
import KitSaveBars from '../components/kit/KitSaveBars.svelte';
import KitOverlays from '../components/kit/KitOverlays.svelte';
import SegmentedControl from '../components/ui/SegmentedControl.svelte';
import KitControls from '../components/kit/KitControls.svelte';
import KitDays from '../components/kit/KitDays.svelte';
import { appUrl } from '../lib/paths';
import Plus from '@lucide/astro/icons/plus';
import Trash from '@lucide/astro/icons/trash';
import Dumbbell from '@lucide/astro/icons/dumbbell';
import Inbox from '@lucide/astro/icons/inbox';

// Token di colore mostrati nel kit, con il loro uso (testo per chi legge la pagina)
const contentColors = [
  ['background', 'Fondo della pagina'],
  ['surface', 'Pannelli e fogli'],
  ['field', 'Campi'],
  ['foreground', 'Testo'],
  ['muted', 'Etichette, metadati, segnaposto'],
  ['line', 'Separatori'],
  ['line-strong', 'Bordi dei controlli'],
  ['accent', 'Azione primaria, selezione'],
  ['accent-text', 'Link, icone attive'],
  ['done', 'Serie fatta'],
  ['danger', 'Azioni distruttive, errori'],
  ['warning-bg', 'Avvisi'],
];
const shellColors = [
  ['shell', 'Intestazione, barre, timer'],
  ['shell-accent', 'Accento lime sul guscio'],
  ['level', 'Livello del timer'],
  ['shell-muted', 'Testo secondario sul guscio'],
];
const weightUnits = [
  { value: 'kg', label: 'kg' },
  { value: 'lb', label: 'lb' },
] as const;
---

<Base title="Kit · BodyTracker" description="Componenti base del design system di BodyTracker.">
  <AppHeader title="Kit del design system" subtitle="Componenti base · pagina interna" />

  <main class="mx-auto flex max-w-2xl flex-col gap-12 px-4 pt-6 pb-40">
    <section aria-labelledby="s-theme" class="flex flex-col gap-3">
      <h2 id="s-theme" class="text-page-title font-bold">Tema</h2>
      <p class="text-muted">
        Il contenuto cambia con il tema; il guscio verde scuro resta uguale. La scelta vale per questo dispositivo.
      </p>
      <KitTheme client:load />
    </section>

    <section aria-labelledby="s-colors" class="flex flex-col gap-3">
      <h2 id="s-colors" class="text-page-title font-bold">Colori</h2>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-3">
        {
          contentColors.map(([name, use]) => (
            <li class="flex items-center gap-3">
              <span class="size-10 shrink-0 rounded-[var(--radius-field)] border border-line" style={`background: var(--color-${name})`} />
              <span class="min-w-0 text-sm leading-tight">
                <span class="font-semibold">{name}</span>
                <span class="block text-muted">{use}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <ul class="shell grid grid-cols-2 gap-x-4 gap-y-3 rounded-[var(--radius-panel)] p-4 sm:grid-cols-4">
        {
          shellColors.map(([name, use]) => (
            <li class="flex items-center gap-3">
              <span class="size-10 shrink-0 rounded-[var(--radius-field)] border border-shell-line-strong" style={`background: var(--color-${name})`} />
              <span class="min-w-0 text-sm leading-tight">
                <span class="font-semibold">{name}</span>
                <span class="block text-shell-muted">{use}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="s-type" class="flex flex-col gap-3">
      <h2 id="s-type" class="text-page-title font-bold">Tipografia</h2>
      <div class="panel flex flex-col gap-3">
        <p class="text-page-title font-bold tracking-[-0.01em]">Scheda A · lunedì</p>
        <p class="text-xl leading-snug font-bold">Rematore manubri, petto su panca inclinata</p>
        <p>Atkinson Hyperlegible Next, disegnato per distinguere ogni lettera a colpo d'occhio: Il1 O0 rn m.</p>
        <p class="label mb-0">Etichetta · recupero predefinito</p>
        <p class="digits">37,5 kg × 8 · 1:15 · 2.450 kg</p>
      </div>
    </section>

    <section aria-labelledby="s-buttons" class="flex flex-col gap-4">
      <h2 id="s-buttons" class="text-page-title font-bold">Pulsanti</h2>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn btn-primary">Inizia allenamento</button>
        <button type="button" class="btn btn-secondary">Altra scheda</button>
        <button type="button" class="btn btn-danger"><Trash aria-hidden="true" />Elimina</button>
        <button type="button" class="btn btn-text"><Plus aria-hidden="true" />Aggiungi esercizio</button>
        <button type="button" class="btn btn-icon" aria-label="Aggiungi"><Plus size={22} aria-hidden="true" /></button>
        <button type="button" class="btn btn-primary" disabled>Termina</button>
      </div>
      <button type="button" class="btn btn-primary btn-block">Inizia allenamento</button>
      <div class="shell flex flex-wrap items-center gap-3 rounded-[var(--radius-panel)] p-4">
        <button type="button" class="btn btn-primary">Termina</button>
        <button type="button" class="btn btn-secondary">Salva ora</button>
        <button type="button" class="btn btn-text">Riapri</button>
      </div>
    </section>

    <section aria-labelledby="s-fields" class="flex flex-col gap-4">
      <h2 id="s-fields" class="text-page-title font-bold">Campi e selettori</h2>
      <div>
        <label class="label" for="k-name">Nome della sessione</label>
        <input id="k-name" class="field" value="Scheda A" />
        <p class="hint">Visibile nello storico e nel calendario.</p>
      </div>
      <div>
        <label class="label" for="k-rest">Recupero predefinito</label>
        <input id="k-rest" class="field digits" inputmode="numeric" value="1:3" aria-invalid="true" aria-describedby="k-rest-error" />
        <p class="field-error" id="k-rest-error">Scrivi il recupero come minuti:secondi, ad esempio 1:30.</p>
      </div>
      <div>
        <label class="label" for="k-routine">Scheda di lunedì</label>
        <select id="k-routine" class="field">
          <option>Scheda A</option>
          <option>Scheda B</option>
          <option>Riposo</option>
        </select>
      </div>
      <SegmentedControl name="weight-unit" label="Unità di peso" options={weightUnits} value="kg" client:load />
      <KitControls client:load />
    </section>

    <section aria-labelledby="s-sets" class="flex flex-col gap-3">
      <h2 id="s-sets" class="text-page-title font-bold">Riga serie</h2>
      <p class="text-muted">
        Spunta su una riga vuota: conferma il precedente e parte il recupero. Tocco sul numero: cambia tipo (R, D, C).
      </p>
      <KitSetRows client:load />
    </section>

    <section aria-labelledby="s-timer" class="flex flex-col gap-3">
      <h2 id="s-timer" class="text-page-title font-bold">Timer di recupero</h2>
      <p class="text-muted">Il livello scende a ogni secondo; negli ultimi 10 s le cifre diventano lime, alla fine tutto lo schermo.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <RestTimer duration={120} preview={84} next="Panca piana · serie 2 · 40 kg × 6–8" />
        <RestTimer duration={120} preview={7} next="Panca piana · serie 2 · 40 kg × 6–8" />
        <RestTimer duration={120} preview={0} next="Panca piana · serie 2 · 40 kg × 6–8" />
        <RestTimer duration={900} preview={725} next={null} />
      </div>
      <RestTimer duration={120} preview={52} previewMinimized next="Rematore manubri · serie 2 · 12 kg × 8–10" />
    </section>

    <section aria-labelledby="s-days" class="flex flex-col gap-3">
      <h2 id="s-days" class="text-page-title font-bold">Giorni del calendario</h2>
      <p class="text-muted">Ogni stato ha un’icona e un testo, mai il solo colore. Oggi ha il bordo; un tocco porta al giorno nel Calendario.</p>
      <KitDays client:load />
    </section>

    <section aria-labelledby="s-save-bar" class="flex flex-col gap-3">
      <h2 id="s-save-bar" class="text-page-title font-bold">Barra di salvataggio</h2>
      <KitSaveBars client:visible />
    </section>

    <section aria-labelledby="s-overlays" class="flex flex-col gap-3">
      <h2 id="s-overlays" class="text-page-title font-bold">Fogli, conferme e avvisi</h2>
      <KitOverlays client:load />
    </section>

    <section aria-labelledby="s-empty" class="flex flex-col gap-1">
      <h2 id="s-empty" class="text-page-title font-bold">Stato vuoto</h2>
      <div class="panel">
        <EmptyState title="Nessuna sessione ancora" text="Le sessioni concluse compaiono qui, dalla più recente. Inizia dalla scheda di oggi.">
          <Inbox slot="icon" size={28} />
          <a href={appUrl('/')} class="btn btn-primary"><Dumbbell aria-hidden="true" />Vai a Oggi</a>
        </EmptyState>
      </div>
    </section>
  </main>

  <div class="fixed inset-x-0 bottom-0 z-20">
    <TabBar active="today" />
  </div>
</Base>
