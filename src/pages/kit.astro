---
// Pagina interna del design system: tutti i componenti base nei due temi.
// Fuori dalla navigazione, noindex; da escludere dal precache allo step 3. ?tema=chiaro|scuro forza il tema.
import Base from '../layouts/Base.astro';
import Intestazione from '../components/ui/Intestazione.astro';
import TabBar from '../components/ui/TabBar.astro';
import StatoVuoto from '../components/ui/StatoVuoto.astro';
import TimerRecupero from '../components/allenamento/TimerRecupero.svelte';
import KitTema from '../components/kit/KitTema.svelte';
import KitRighe from '../components/kit/KitRighe.svelte';
import KitBarre from '../components/kit/KitBarre.svelte';
import KitFinestre from '../components/kit/KitFinestre.svelte';
import Segmentato from '../components/ui/Segmentato.svelte';
import Plus from '@lucide/astro/icons/plus';
import Trash from '@lucide/astro/icons/trash';
import Dumbbell from '@lucide/astro/icons/dumbbell';
import Inbox from '@lucide/astro/icons/inbox';

const contenuto = [
  ['fondo', 'Fondo della pagina'],
  ['superficie', 'Pannelli e fogli'],
  ['campo', 'Campi'],
  ['testo', 'Testo'],
  ['secondario', 'Etichette, metadati, segnaposto'],
  ['linea', 'Separatori'],
  ['linea-forte', 'Bordi dei controlli'],
  ['accento', 'Azione primaria, selezione'],
  ['accento-testo', 'Link, icone attive'],
  ['fatto', 'Serie fatta'],
  ['pericolo', 'Azioni distruttive, errori'],
  ['avviso-fondo', 'Avvisi'],
];
const guscio = [
  ['guscio', 'Intestazione, barre, timer'],
  ['guscio-accento', 'Accento lime sul guscio'],
  ['livello', 'Livello del timer'],
  ['guscio-secondario', 'Testo secondario sul guscio'],
];
const unita = [
  { valore: 'kg', etichetta: 'kg' },
  { valore: 'lb', etichetta: 'lb' },
] as const;
---

<Base title="Kit · BodyTracker" description="Componenti base del design system di BodyTracker.">
  <Intestazione titolo="Kit del design system" sottotitolo="Componenti base · pagina interna" />

  <main class="mx-auto flex max-w-2xl flex-col gap-12 px-4 pt-6 pb-40">
    <section aria-labelledby="s-tema" class="flex flex-col gap-3">
      <h2 id="s-tema" class="text-titolo-pagina font-bold">Tema</h2>
      <p class="text-secondario">
        Il contenuto cambia con il tema; il guscio verde scuro resta uguale. La scelta vale per questo dispositivo.
      </p>
      <KitTema client:load />
    </section>

    <section aria-labelledby="s-colori" class="flex flex-col gap-3">
      <h2 id="s-colori" class="text-titolo-pagina font-bold">Colori</h2>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-3">
        {
          contenuto.map(([nome, uso]) => (
            <li class="flex items-center gap-3">
              <span class="size-10 shrink-0 rounded-[var(--radius-campo)] border border-linea" style={`background: var(--color-${nome})`} />
              <span class="min-w-0 text-sm leading-tight">
                <span class="font-semibold">{nome}</span>
                <span class="block text-secondario">{uso}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <ul class="guscio grid grid-cols-2 gap-x-4 gap-y-3 rounded-[var(--radius-pannello)] p-4 sm:grid-cols-4">
        {
          guscio.map(([nome, uso]) => (
            <li class="flex items-center gap-3">
              <span class="size-10 shrink-0 rounded-[var(--radius-campo)] border border-guscio-linea-forte" style={`background: var(--color-${nome})`} />
              <span class="min-w-0 text-sm leading-tight">
                <span class="font-semibold">{nome}</span>
                <span class="block text-guscio-secondario">{uso}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="s-tipo" class="flex flex-col gap-3">
      <h2 id="s-tipo" class="text-titolo-pagina font-bold">Tipografia</h2>
      <div class="pannello flex flex-col gap-3">
        <p class="text-titolo-pagina font-bold tracking-[-0.01em]">Scheda A · lunedì</p>
        <p class="text-xl leading-snug font-bold">Rematore manubri, petto su panca inclinata</p>
        <p>Atkinson Hyperlegible Next, disegnato per distinguere ogni lettera a colpo d'occhio: Il1 O0 rn m.</p>
        <p class="etichetta mb-0">Etichetta · recupero predefinito</p>
        <p class="cifre">37,5 kg × 8 · 1:15 · 2.450 kg</p>
      </div>
    </section>

    <section aria-labelledby="s-pulsanti" class="flex flex-col gap-4">
      <h2 id="s-pulsanti" class="text-titolo-pagina font-bold">Pulsanti</h2>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="pulsante pulsante-primario">Inizia allenamento</button>
        <button type="button" class="pulsante pulsante-secondario">Altra scheda</button>
        <button type="button" class="pulsante pulsante-pericolo"><Trash aria-hidden="true" />Elimina</button>
        <button type="button" class="pulsante pulsante-testo"><Plus aria-hidden="true" />Aggiungi esercizio</button>
        <button type="button" class="pulsante pulsante-icona" aria-label="Aggiungi"><Plus size={22} aria-hidden="true" /></button>
        <button type="button" class="pulsante pulsante-primario" disabled>Termina</button>
      </div>
      <button type="button" class="pulsante pulsante-primario pulsante-ampio">Inizia allenamento</button>
      <div class="guscio flex flex-wrap items-center gap-3 rounded-[var(--radius-pannello)] p-4">
        <button type="button" class="pulsante pulsante-primario">Termina</button>
        <button type="button" class="pulsante pulsante-secondario">Salva ora</button>
        <button type="button" class="pulsante pulsante-testo">Riapri</button>
      </div>
    </section>

    <section aria-labelledby="s-campi" class="flex flex-col gap-4">
      <h2 id="s-campi" class="text-titolo-pagina font-bold">Campi e selettori</h2>
      <div>
        <label class="etichetta" for="k-nome">Nome della sessione</label>
        <input id="k-nome" class="campo" value="Scheda A" />
        <p class="aiuto">Visibile nello storico e nel calendario.</p>
      </div>
      <div>
        <label class="etichetta" for="k-rec">Recupero predefinito</label>
        <input id="k-rec" class="campo cifre" inputmode="numeric" value="1:3" aria-invalid="true" aria-describedby="k-rec-err" />
        <p class="errore-campo" id="k-rec-err">Scrivi il recupero come minuti:secondi, ad esempio 1:30.</p>
      </div>
      <div>
        <label class="etichetta" for="k-scheda">Scheda di lunedì</label>
        <select id="k-scheda" class="campo">
          <option>Scheda A</option>
          <option>Scheda B</option>
          <option>Riposo</option>
        </select>
      </div>
      <Segmentato nome="unita" etichetta="Unità di peso" opzioni={unita} valore="kg" client:load />
    </section>

    <section aria-labelledby="s-serie" class="flex flex-col gap-3">
      <h2 id="s-serie" class="text-titolo-pagina font-bold">Riga serie</h2>
      <p class="text-secondario">
        Spunta su una riga vuota: conferma il precedente e parte il recupero. Tocco sul numero: cambia tipo (R, D, C).
      </p>
      <KitRighe client:load />
    </section>

    <section aria-labelledby="s-timer" class="flex flex-col gap-3">
      <h2 id="s-timer" class="text-titolo-pagina font-bold">Timer di recupero</h2>
      <p class="text-secondario">Il livello scende a ogni secondo; negli ultimi 10 s le cifre diventano lime, alla fine tutto lo schermo.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <TimerRecupero durata={120} anteprima={84} prossima="Panca piana · serie 2 · 40 kg × 6–8" />
        <TimerRecupero durata={120} anteprima={7} prossima="Panca piana · serie 2 · 40 kg × 6–8" />
        <TimerRecupero durata={120} anteprima={0} prossima="Panca piana · serie 2 · 40 kg × 6–8" />
        <TimerRecupero durata={900} anteprima={725} prossima={null} />
      </div>
      <TimerRecupero durata={120} anteprima={52} anteprimaRidotta prossima="Rematore manubri · serie 2 · 12 kg × 8–10" />
    </section>

    <section aria-labelledby="s-barra" class="flex flex-col gap-3">
      <h2 id="s-barra" class="text-titolo-pagina font-bold">Barra di salvataggio</h2>
      <KitBarre client:visible />
    </section>

    <section aria-labelledby="s-finestre" class="flex flex-col gap-3">
      <h2 id="s-finestre" class="text-titolo-pagina font-bold">Fogli, conferme e avvisi</h2>
      <KitFinestre client:load />
    </section>

    <section aria-labelledby="s-vuoto" class="flex flex-col gap-1">
      <h2 id="s-vuoto" class="text-titolo-pagina font-bold">Stato vuoto</h2>
      <div class="pannello">
        <StatoVuoto titolo="Nessuna sessione ancora" testo="Le sessioni concluse compaiono qui, dalla più recente. Inizia dalla scheda di oggi.">
          <Inbox slot="icona" size={28} />
          <a href="/" class="pulsante pulsante-primario"><Dumbbell aria-hidden="true" />Vai a Oggi</a>
        </StatoVuoto>
      </div>
    </section>
  </main>

  <div class="fixed inset-x-0 bottom-0 z-20">
    <TabBar attiva="oggi" />
  </div>
</Base>
