---
import WorkoutEditor from '../components/WorkoutEditor.astro'
import CalendarConfig from '../components/CalendarConfig.astro'
import HistoryView from '../components/HistoryView.astro'
import { SITE_TITLE } from '../consts';

import "../styles/global.css";
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>BodyTracker — Allenamenti</title>
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_TITLE}
			href={new URL('rss.xml', Astro.site)}
		/>
	</head>
	<body class="bg-slate-50 text-slate-900 min-h-screen flex items-start py-8">
		<main class="container mx-auto bg-white p-6 rounded-2xl shadow">
			<h1 class="text-2xl font-semibold mb-4">BodyTracker — Allenamenti</h1>

		<section class="grid md:grid-cols-2 gap-6">
			<div>
				<CalendarConfig />
			</div>


			<div>
				<WorkoutEditor />
			</div>
		</section>

		<section class="mt-6">
			<HistoryView />
		</section>

		</main>
	</body>
</html>