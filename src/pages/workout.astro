---
import Layout from '../layouts/Layout.astro';

// Pagina statica: la data arriva dal parametro ?date=YYYY-MM-DD e viene letta lato client.
---

<Layout
  title="Allenamento — BodyTracker"
  description="Visualizza e modifica l'allenamento di un giorno"
  showBackButton={true}
>
  <div class="max-w-4xl mx-auto" data-workout-page>
    <!-- Date Header -->
    <div class="bg-linear-to-r from-blue-600 to-blue-700 text-white p-8 rounded-2xl shadow-lg mb-6">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-sm font-medium opacity-90 mb-1" id="workout-day-name"></div>
          <h1 class="text-3xl font-bold mb-2" id="workout-date-label"></h1>
          <p class="text-blue-100" id="workout-plan-label">
            <!-- Will be filled by JavaScript -->
          </p>
        </div>
        <div class="text-6xl">
          🏋️‍♂️
        </div>
      </div>
    </div>

    <!-- Workout Editor for this specific date -->
    <div class="bg-white p-8 rounded-2xl shadow-lg mb-6">
      <div class="border-b pb-4 mb-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">
          Scheda Allenamento
        </h2>
        <p class="text-gray-600 text-sm">
          Modifica gli esercizi e salva i tuoi progressi
        </p>
      </div>

      <div id="exercise-list" class="space-y-4 mb-6"></div>

      <div class="flex justify-between items-center pt-6 border-t">
        <button
          id="add-exercise"
          class="bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition shadow-md hover:shadow-lg font-medium"
        >
          + Aggiungi esercizio
        </button>

        <button
          id="save-workout"
          class="bg-green-600 text-white py-3 px-6 rounded-lg hover:bg-green-700 transition shadow-md hover:shadow-lg font-medium"
        >
          💾 Salva allenamento
        </button>
      </div>
    </div>

    <!-- History for this date -->
    <div class="bg-white p-8 rounded-2xl shadow-lg">
      <div class="border-b pb-4 mb-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">
          Storico di questo giorno
        </h2>
        <p class="text-gray-600 text-sm">
          Allenamenti passati dello stesso giorno della settimana
        </p>
      </div>

      <div id="history-list" class="space-y-3">
        <!-- Will be filled by JavaScript -->
      </div>
    </div>
  </div>

  <script>
    import { getWorkout, putWorkout, loadWorkouts, loadCalendar, parseDateKey, dayNameOf, escapeHtml, workoutUrl, type Workout } from '../scripts/bodytracker';
    import { mountExerciseList, promptNewExercise } from '../scripts/exercise-list';

    const date = new URLSearchParams(window.location.search).get('date') ?? '';
    const dateObj = parseDateKey(date);

    if (!dateObj) {
      window.location.replace('/');
    } else {
      const root = document.querySelector<HTMLElement>('[data-workout-page]')!;
      const list = root.querySelector<HTMLElement>('#exercise-list')!;
      const addExerciseBtn = root.querySelector<HTMLButtonElement>('#add-exercise')!;
      const saveBtn = root.querySelector<HTMLButtonElement>('#save-workout')!;
      const historyList = root.querySelector<HTMLElement>('#history-list')!;

      const formattedDate = dateObj.toLocaleDateString('it-IT', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      const dayName = dayNameOf(dateObj);

      document.title = `Allenamento ${formattedDate} — BodyTracker`;
      root.querySelector('#workout-day-name')!.textContent = dayName;
      root.querySelector('#workout-date-label')!.textContent = formattedDate;
      root.querySelector('#workout-plan-label')!.textContent =
        `Scheda: ${loadCalendar()[dayName] || 'Nessuna scheda assegnata'}`;

      let workout: Workout = getWorkout(date);

      const render = mountExerciseList(list, {
        getWorkout: () => workout,
        onChange: () => {},
        emptyText: 'Inizia ad aggiungere esercizi per questo giorno',
      });

      function renderHistory() {
        // Allenamenti dello stesso giorno della settimana, dal più recente
        const sameDayWorkouts = loadWorkouts()
          .filter((w) => w.date !== date && parseDateKey(w.date)!.getDay() === dateObj!.getDay())
          .reverse();

        historyList.innerHTML = '';

        if (sameDayWorkouts.length === 0) {
          historyList.innerHTML = `
            <div class="text-center py-8 text-gray-500">
              <p>Nessun allenamento precedente per questo giorno della settimana.</p>
            </div>
          `;
          return;
        }

        sameDayWorkouts.forEach((w) => {
          const workoutDate = parseDateKey(w.date)!.toLocaleDateString('it-IT', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });

          const card = document.createElement('a');
          card.href = workoutUrl(w.date);
          card.className = 'block p-4 border rounded-lg bg-gray-50 hover:bg-gray-100 transition';

          const exercisesSummary = w.exercises
            .map((ex) => `<div class="text-sm"><strong>${escapeHtml(ex.name)}</strong> - ${ex.sets.length} serie</div>`)
            .join('');

          card.innerHTML = `
            <div class="flex justify-between items-start mb-2">
              <div class="font-semibold text-gray-800">${escapeHtml(workoutDate)}</div>
              <div class="text-xs text-gray-500">${w.exercises.length} esercizi</div>
            </div>
            <div class="space-y-1">
              ${exercisesSummary}
            </div>
          `;

          historyList.appendChild(card);
        });
      }

      addExerciseBtn.addEventListener('click', () => {
        if (promptNewExercise(workout)) render();
      });

      saveBtn.addEventListener('click', () => {
        putWorkout(workout);
        alert('Allenamento salvato!');
        renderHistory();
      });

      render();
      renderHistory();
    }
  </script>
</Layout>
